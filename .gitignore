# Nested git repositories — each keeps its own history.
/tex4npm/
/ximeraLatex/
/app.modulus-learning.org/

# npm build output
dist/
node_modules/

# tex4npm staging (regenerated on every build)
.tex4npm/

# tex4ht raw HTML leaks into the source dir next to the .tex; only dist/*.html
# is authoritative. Same for the AUCTeX auto/ helper dir.
/my-course/src/*.html
/specs/fixtures/*.html
auto/

# LaTeX build intermediates. tex4npm normally sweeps these but leaves some
# behind (see tex4npm/src/compile.js Step 7); this is the belt-and-suspenders.
*.aux
*.log
*.fls
*.4ct
*.4tc
*.lg
*.idv
*.ids
*.out
*.oc
*.md5
*.dpth
*.tmp
*.xref
*.dvi
*.pdf
*.auxlock
*.scmd
*.sout
*.sagetex.sage
*.sagetex.sout
*.jax
*.synctex.gz

# Editor / OS junk
*~
.DS_Store
.vscode/
.idea/

# npm scratch
package-lock.json.tmp
