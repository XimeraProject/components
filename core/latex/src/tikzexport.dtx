% \subsubsection{TikZ export}
% We generate one SVG per TikZ picture using TikZ's ``externalize''
% feature: in the pdflatex pass, each picture is compiled to its own
% PDF via a nested pdflatex invocation, then converted to SVG with
% \verb|pdftocairo|. In the htlatex pass, TikZ sees the pre-existing
% SVG files (\verb|mode=graphics if exists|) and replaces each picture
% with \verb|\includegraphics{...svg}|, which tex4ht turns into an
% \verb|<img>| tag. This side-steps tex4ht's own tikz conversion, which
% produces structurally invalid SVGs for pgfplots and TikZ matrices.
%    \begin{macrocode}
%<*classXimera>
\ifdefined\HCode
  \tikzexporttrue
\fi

\iftikzexport
  % Old tkz-euclide (v2.x) users still write \usetkzobj{all} in their
  % preambles, but tkz-euclide v3+ preloads everything and no longer
  % defines the macro. In the child compile below (nonstopmode), the
  % undefined \usetkzobj is silently dropped by TeX's error recovery
  % but its brace-argument survives as ordinary tokens and gets typeset
  % into the picture. Stub it to a no-op so the "all" doesn't bleed
  % into the SVG. Scoped to tikzexport passes only.
  \providecommand{\usetkzobj}[1]{}

  \usetikzlibrary{external}

  \ifdefined\HCode
    % In htlatex, the pdflatex pass has already produced .pdf+.svg for each
    % tikzpicture. We want tikz's `mode=graphics if exists' to detect the
    % .svg (via \pgfsys@imagesuffixlist) and its include-external handler
    % to emit \includegraphics{...svg}, so tex4ht's \Configure{graphics*}{svg}
    % (loaded by the svg- option in \Preamble{...}) fires and produces an
    % <object type="image/svg+xml">. Defer the handler override to
    % \AtBeginDocument because tex4ht's tikz-hooks.4ht installs a .pdf-based
    % handler late (via \:AtEndOfPackage on tikz.sty, replayed after every
    % tikz-adjacent \RequirePackage).
    \def\pgfsys@imagesuffixlist{.svg:}%
    \def\ximera@setincludeexternal{%
      \pgfkeys{/pgf/images/include external/.code={\includegraphics{##1.svg}}}%
    }%
    \AtBeginDocument{\ximera@setincludeexternal}%
    \tikzexternalize[prefix=./,mode=graphics if exists]
  \else
    % In pdflatex, generate one SVG per picture by running a child latex
    % compile to DVI (tightly cropped to the picture via pgf's own bbox
    % special), then converting the DVI to SVG with dvisvgm.
    % --font-format=woff2 keeps glyphs as selectable text (embedding fonts
    % as WOFF2) rather than converting them to path outlines.
    %
    % Why DVI, not `pdflatex + dvisvgm --pdf`: in --pdf mode dvisvgm
    % recovers a glyph's Unicode value from the PDF's ToUnicode map, which
    % pdflatex does not write for CMEX/CMSY math delimiters. It then falls
    % back to U+FFFD for *every* such glyph, so e.g. the `[` and `]` of a
    % bmatrix inside a tikz node both collapse onto U+FFFD and the woff2
    % subset can only bind that one codepoint to one glyph -- both brackets
    % render as the same shape. On DVI, dvisvgm reads the font's own
    % encoding (cmex10) and assigns each delimiter a distinct codepoint, so
    % the brackets render correctly and stay selectable.
    %
    % The pgf bbox concern that once motivated --pdf does not reproduce on
    % the current toolchain: pgf's `dvisvgm:bbox ... lock` pins the DVI bbox
    % to the same bounds it writes into the PDF CropBox, so DVI-default and
    % --pdf agree to well under 1pt (no blank band). Add --exact-bbox if a
    % tighter ink-based box is ever wanted; it overrides the lock and is
    % never larger than --pdf.
    %
    % Caveat: DVI mode cannot embed raster images (PNG/JPG); a tikzpicture
    % that \includegraphics a bitmap must supply an EPS version instead.
    %
    % nonstopmode (not batch/halt-on-error) so the child compile survives
    % preamble warnings the same way the main compile does. If we halted
    % on any error, common preamble quirks (e.g. \usetkzobj{all} in older
    % tkz-euclide callers) would abort every picture even though the
    % picture itself is fine and the main compile keeps going.
    \tikzset{
      /tikz/external/system call={
        latex \tikzexternalcheckshellescape
        -interaction=nonstopmode
        -jobname "\image" "\\PassOptionsToClass{tikzexport}{ximera}\texsource";
        dvisvgm --font-format=woff2 -o \image.svg \image.dvi
      }
    }
    \tikzexternalize[optimize=false,prefix=./]
  \fi
\fi
%</classXimera>
%    \end{macrocode}
