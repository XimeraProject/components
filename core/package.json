{
  "name": "@ximera/core",
  "version": "2.0.0",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./kernel": "./kernel.js",
    "./conformance": "./conformance.js",
    "./*.css": "./*.css"
  },
  "latex": {
    "cls": [
      "latex/dist/ximera.cls",
      "latex/dist/xourse.cls"
    ],
