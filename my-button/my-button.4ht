% my-button.4ht — tex4ht hooks for the my-button package.
% Loaded from my-button.sty inside \ifdefined\HCode.

\newcounter{ximeraButtonId}
\setcounter{ximeraButtonId}{0}

\renewcommand{\button}[2][]{%
  \setkeys{button}{#1}%
  \stepcounter{ximeraButtonId}%
  \HCode{<button class="ximera-button" id="ximera-button-\arabic{ximeraButtonId}" data-count="\btn@count">}%
    #2%
  \HCode{</button>}%
}

\endinput
