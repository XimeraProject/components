% foldable.4ht — tex4ht hooks for the foldable environment.
% Loaded from foldable.sty inside \ifdefined\HCode.

\renewenvironment{foldable}
  {\stepcounter{identification}\ifvmode\IgnorePar\fi\EndP
   \HCode{<div id="foldable\arabic{identification}" class="foldable">}}
  {\HCode{</div>}\IgnoreIndent}

% If the author opted out of expandable-as-accordion, the "expandable"
% environment (which accordion.dtx normally re-implements as a headed
% accordion) instead renders as a plain foldable div. The default path
% (accordion) is owned by ximera-core's accordion.dtx.
\ifdefined\xmNotExpandableAsAccordion
\renewenvironment{expandable}
  {\stepcounter{identification}\ifvmode\IgnorePar\fi\EndP
   \HCode{<div data-original="expandable" id="foldable\arabic{identification}" class="foldable">}}
  {\HCode{</div>}\IgnoreIndent}
\fi

\renewcommand{\unfoldable}[1]{\HCode{<span class="unfoldable">}#1\HCode{</span>}}

\endinput
