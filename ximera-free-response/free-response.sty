\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{free-response}[2026/08/16 v0.1 Ximera freeResponse environment (greenfield)]

\RequirePackage{ifthen}

\newboolean{given}
\setboolean{given}{true}

\ifhandout
	\newenvironment{freeResponse}[1][false]%
		{%
		\def\givenatend{\boolean{#1}}
		\ifthenelse{\boolean{#1}}
			{%
			\begin{trivlist}
				\item
			}%
			{%
			\setbox0\vbox\bgroup
			}%
		}
		{%
		\ifthenelse{\givenatend}
			{%
			\end{trivlist}
			}%
			{%
			\egroup
			}%
		}
\else
	\newenvironment{freeResponse}[1][false]%
		{%
		  \ifthenelse{\boolean{#1}}%
		  	{%
		  	\begin{trivlist}
		  		\item[\hskip \labelsep\bfseries \GetTranslation{Free Response (Given)}:\hspace{2ex}]
		  	}%
			{%
			\begin{trivlist}
				\item[\hskip \labelsep\bfseries \GetTranslation{Free Response}:\hspace{2ex}]
			}%
		}
		{%
			\end{trivlist}
		}
\fi

