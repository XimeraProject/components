% ximera-verbatim.4ht — tex4ht hooks for the ximera-verbatim package.
% Loaded from ximera-verbatim.sty inside \ifdefined\HCode.
%
% In HTML mode the fancyvrb frame/numbers fall away; content is emitted
% as plain <pre> blocks (code, python) or a hidden <script> block
% (javascriptCode, read and executed by the Ximera runtime).

\ScriptEnv{code}
  {\ifvmode \IgnorePar\fi \EndP\HCode{<pre class="code">}\HtmlParOff}
  {\HtmlParOn\HCode{</pre>}}

\ScriptEnv{python}
  {\ifvmode \IgnorePar\fi \EndP\HCode{<pre class="python">}\HtmlParOff}
  {\HtmlParOn\HCode{</pre>}}

\renewenvironment{javascriptCode}{\NoFonts}{\EndNoFonts}
\ScriptEnv{javascriptCode}
  {\stepcounter{identification}\ifvmode \IgnorePar\fi \EndP
   \HCode{<div class="javascript-code" id="javascript\arabic{identification}"><script type="text/text">}
   \HtmlParOff}
  {\HtmlParOn\HCode{\Hnewline</script></div>}}

\endinput
